{
  "name": "vscode-functy",
  "displayName": "functy",
  "description": "Syntax highlighting, snippets, commands, and test integration for functy (.cty) files",
  "version": "0.3.0",
  "publisher": "tsarna",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsarna/vscode-functy"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Testing"
  ],
  "keywords": [
    "functy",
    "cty",
    "hcl",
    "cty-lang"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.cty"
  ],
  "contributes": {
    "languages": [
      {
        "id": "functy",
        "aliases": [
          "functy",
          "Functy"
        ],
        "extensions": [
          ".cty"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "functy",
        "scopeName": "source.functy",
        "path": "./syntaxes/functy.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "functy",
        "path": "./snippets/functy.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "functy",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The functy subcommand to run (e.g. check, test, fmt)."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional arguments passed after the subcommand."
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "functyGetStarted",
        "title": "Get Started with functy",
        "description": "Install the CLI and explore functy (.cty) support: run, check, evaluate, and test.",
        "steps": [
          {
            "id": "install",
            "title": "Install the functy CLI",
            "description": "This extension drives the `functy` binary (0.9.0+). Install it (on macOS: `brew install tsarna/tap/functy`), put it on your PATH, or set the path.\n[Open functy.path Setting](command:workbench.action.openSettings?%5B%22functy.path%22%5D)",
            "media": {
              "markdown": "walkthroughs/install.md"
            },
            "completionEvents": [
              "onSettingChanged:functy.path"
            ]
          },
          {
            "id": "sample",
            "title": "Open a sample file",
            "description": "Drop a ready-made `.cty` example into your workspace to explore.\n[Open Sample](command:functy.openSample)",
            "media": {
              "markdown": "walkthroughs/sample.md"
            },
            "completionEvents": [
              "onCommand:functy.openSample"
            ]
          },
          {
            "id": "runcheck",
            "title": "Run and check",
            "description": "Run the entry function, or type-check the file.\n[Run File](command:functy.run) — [Check File](command:functy.check)",
            "media": {
              "markdown": "walkthroughs/runcheck.md"
            },
            "completionEvents": [
              "onCommand:functy.run",
              "onCommand:functy.check"
            ]
          },
          {
            "id": "evaluate",
            "title": "Evaluate an expression",
            "description": "Select an expression (e.g. `add(2, 3)`) and evaluate it inline.\n[Evaluate Selection](command:functy.evaluateSelection)",
            "media": {
              "markdown": "walkthroughs/evaluate.md"
            },
            "completionEvents": [
              "onCommand:functy.evaluateSelection"
            ]
          },
          {
            "id": "tests",
            "title": "Run tests",
            "description": "Open the Testing panel to run the file's `test` blocks.\n[Open Testing](command:workbench.view.testing.focus)",
            "media": {
              "markdown": "walkthroughs/tests.md"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "functy.run",
        "title": "Run File",
        "category": "functy"
      },
      {
        "command": "functy.runWithArgs",
        "title": "Run with Arguments…",
        "category": "functy"
      },
      {
        "command": "functy.check",
        "title": "Check File",
        "category": "functy"
      },
      {
        "command": "functy.checkWorkspace",
        "title": "Check Workspace",
        "category": "functy"
      },
      {
        "command": "functy.formatWorkspace",
        "title": "Format Workspace",
        "category": "functy"
      },
      {
        "command": "functy.evaluateSelection",
        "title": "Evaluate Selection",
        "category": "functy"
      },
      {
        "command": "functy.formatDocument",
        "title": "Format Document",
        "category": "functy"
      },
      {
        "command": "functy.openSample",
        "title": "Open Sample File",
        "category": "functy"
      },
      {
        "command": "functy.startRepl",
        "title": "Start REPL",
        "category": "functy"
      },
      {
        "command": "functy.sendToRepl",
        "title": "Send Selection to REPL",
        "category": "functy"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "functy.run",
          "when": "resourceLangId == functy",
          "group": "functy"
        }
      ],
      "commandPalette": [
        {
          "command": "functy.run",
          "when": "resourceLangId == functy"
        },
        {
          "command": "functy.runWithArgs",
          "when": "resourceLangId == functy"
        },
        {
          "command": "functy.check",
          "when": "resourceLangId == functy"
        },
        {
          "command": "functy.checkWorkspace",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "functy.formatWorkspace",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "functy.formatDocument",
          "when": "resourceLangId == functy"
        },
        {
          "command": "functy.evaluateSelection",
          "when": "resourceLangId == functy"
        },
        {
          "command": "functy.sendToRepl",
          "when": "resourceLangId == functy"
        }
      ],
      "editor/context": [
        {
          "command": "functy.evaluateSelection",
          "when": "resourceLangId == functy && editorHasSelection",
          "group": "functy@1"
        },
        {
          "command": "functy.sendToRepl",
          "when": "resourceLangId == functy",
          "group": "functy@2"
        }
      ]
    },
    "configuration": {
      "title": "functy",
      "properties": {
        "functy.path": {
          "type": "string",
          "default": "functy",
          "description": "Path to the functy binary (a single executable, not a command line with arguments). Defaults to 'functy' on your PATH."
        },
        "functy.runFunc": {
          "type": "string",
          "default": "main",
          "description": "Entry function invoked by the 'functy: Run File' command. May be fully qualified (e.g. 'acme::math::main'); a bare name is resolved when it is unambiguous across namespaces."
        },
        "functy.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Type-check .cty files with 'functy check' when they are saved, reporting diagnostics in the Problems panel. Check is side-effect-free (it does not run your code)."
        },
        "functy.checkOnType": {
          "type": "boolean",
          "default": false,
          "description": "Type-check the unsaved buffer live as you type (debounced), via 'functy check --json -', instead of only on save. Off by default because it spawns a functy process on each edit pause. When enabled, it supersedes check-on-save."
        },
        "functy.maxSteps": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "markdownDescription": "Steps a single functy function invocation may take before a runaway loop is aborted, passed as `--max-steps`. Leave unset to use functy's own default; `0` disables the limit entirely. Requires **functy 0.11.0 or newer** — the flag is only passed when you set this, so leaving it unset keeps older binaries working."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0"
  }
}
