{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "functy",
  "scopeName": "source.functy",
  "fileTypes": ["cty"],
  "patterns": [
    { "include": "#comment_block" },
    { "include": "#comment_line" },
    { "include": "#namespace_decl" },
    { "include": "#func_decl" },
    { "include": "#type_decl" },
    { "include": "#test_decl" },
    { "include": "#declaration_keyword" },
    { "include": "#control_keyword" },
    { "include": "#error_keyword" },
    { "include": "#literal" },
    { "include": "#type_keyword" },
    { "include": "#string" },
    { "include": "#heredoc" },
    { "include": "#number" },
    { "include": "#qualified_call" },
    { "include": "#builtin_function" },
    { "include": "#function_call" },
    { "include": "#param_modifier" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment_line": {
      "patterns": [
        {
          "comment": "A functy-recognized file directive: //functy:extern and friends. Split out from the generic directive rule below so the directive NAME is scoped as a keyword — an extern file is declared by nothing but this line, and it must be visibly different from a comment. Host directives (//vinculum:cache 5m) still fall through to the generic rule.",
          "match": "(//)(functy)(:)([a-zA-Z_][A-Za-z0-9_-]*)(.*)$",
          "captures": {
            "0": { "name": "comment.line.double-slash.directive.functy" },
            "2": { "name": "entity.name.namespace.directive.functy" },
            "4": { "name": "keyword.control.directive.functy" },
            "5": { "name": "meta.directive.arguments.functy" }
          }
        },
        {
          "comment": "Directive comment: //<namespace>:<name> with no space after //",
          "name": "comment.line.double-slash.directive.functy",
          "match": "(//)([a-zA-Z_][A-Za-z0-9_.-]*:[^\\s].*)$"
        },
        {
          "name": "comment.line.double-slash.functy",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.functy",
          "match": "#.*$"
        }
      ]
    },
    "comment_block": {
      "name": "comment.block.functy",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "namespace_decl": {
      "comment": "top-level namespace declaration: namespace foo or namespace foo::bar. Anchored at line start because `namespace` is a CONTEXTUAL keyword — it stays a legal identifier everywhere else (func namespace(), var namespace = 1), so it must never be matched by the bare declaration_keyword alternation.",
      "match": "^\\s*(namespace)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:::[a-zA-Z_][a-zA-Z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.control.namespace.functy" },
        "2": { "name": "entity.name.namespace.functy" }
      }
    },
    "func_decl": {
      "comment": "func <name> — colorize the declaration keyword and function name",
      "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.function.functy" },
        "2": { "name": "entity.name.function.functy" }
      }
    },
    "type_decl": {
      "comment": "top-level type alias: type <Name> = ...",
      "match": "^\\s*(type)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.functy" },
        "2": { "name": "entity.name.type.functy" }
      }
    },
    "test_decl": {
      "comment": "top-level test block: test \"description\" { ... }",
      "match": "^\\s*(test)\\b(?=\\s*\")",
      "captures": {
        "1": { "name": "keyword.control.test.functy" }
      }
    },
    "declaration_keyword": {
      "name": "storage.type.functy",
      "match": "\\b(func|var|const)\\b"
    },
    "control_keyword": {
      "name": "keyword.control.functy",
      "match": "\\b(if|else|for|while|in|break|continue|switch|case|default|fallthrough|return)\\b"
    },
    "error_keyword": {
      "name": "keyword.control.exception.functy",
      "match": "\\b(try|catch|finally|defer|throw)\\b"
    },
    "literal": {
      "name": "constant.language.functy",
      "match": "\\b(true|false|null)\\b"
    },
    "type_keyword": {
      "patterns": [
        {
          "name": "support.type.primitive.functy",
          "match": "\\b(string|number|bool|any)\\b"
        },
        {
          "comment": "`error` is both a built-in named type (var e: error, catch e: error) and a built-in function (error(\"boom\")). type_keyword is included before builtin_function, so this rule must exclude the call form or it would swallow it.",
          "name": "support.type.primitive.functy",
          "match": "\\b(error)\\b(?!\\s*\\()"
        },
        {
          "comment": "type constructors, only in constructor form: list(...), object({...})",
          "name": "support.type.functy",
          "match": "\\b(list|set|map|object|tuple|optional)\\b(?=\\s*\\()"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.functy",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "meta.embedded.line.functy",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.functy" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.functy" }
          },
          "patterns": [ { "include": "#expression" } ]
        },
        {
          "name": "meta.embedded.line.functy",
          "begin": "%\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.functy" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.functy" }
          },
          "patterns": [
            { "include": "#control_keyword" },
            { "include": "#expression" }
          ]
        },
        {
          "name": "constant.character.escape.functy",
          "match": "\\\\."
        }
      ]
    },
    "heredoc": {
      "name": "string.unquoted.heredoc.functy",
      "begin": "<<-?(\\w+)$",
      "beginCaptures": {
        "1": { "name": "keyword.operator.heredoc.functy" }
      },
      "end": "^\\s*\\1$",
      "endCaptures": {
        "0": { "name": "keyword.operator.heredoc.functy" }
      },
      "patterns": [
        {
          "name": "meta.embedded.line.functy",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.functy" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.functy" }
          },
          "patterns": [ { "include": "#expression" } ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.functy",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.functy",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "qualified_call": {
      "comment": "A namespaced call: acme::math::double(1). Must precede builtin_function and function_call — otherwise builtin_function would color the final segment of acme::text::assert(...) as the built-in `assert` (it is not: a namespace's own function shadows the built-in inside it), and function_call would scope only that last segment, leaving the qualifier path unstyled.",
      "match": "\\b((?:[a-zA-Z_][a-zA-Z0-9_]*::)+)([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.namespace.functy" },
        "2": { "name": "entity.name.function.call.functy" }
      }
    },
    "builtin_function": {
      "comment": "The baseline built-ins: Stdlib() (typeof, typekind, cond, switch, error, assert), StdlibExtras() (try, can), the CLI's doc/help, and the test-only skip. Deliberately NOT a guess-list — every name here exists in functy's sources.",
      "name": "support.function.builtin.functy",
      "match": "\\b(assert|skip|error|cond|switch|try|can|typeof|typekind|doc|help)\\b(?=\\s*\\()"
    },
    "param_modifier": {
      "patterns": [
        {
          "comment": "An optional parameter with no default: `func f(ctx?, x: string)`. The `?` is only legal in an extern file, and it is followed by a ',' or ')' — a ternary's '?' is always followed by an expression, so this cannot steal one.",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)(\\?)(?=\\s*[,)]|\\s*:)",
          "captures": {
            "1": { "name": "variable.parameter.functy" },
            "2": { "name": "keyword.operator.optional.functy" }
          }
        },
        {
          "comment": "A variadic parameter: `func f(*args: string)`. Anchored to the opening paren or a preceding comma so it is never confused with multiplication.",
          "match": "([(,])(\\s*)(\\*)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "3": { "name": "keyword.operator.variadic.functy" },
            "4": { "name": "variable.parameter.functy" }
          }
        }
      ]
    },
    "function_call": {
      "name": "entity.name.function.call.functy",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.functy",
          "match": "->"
        },
        {
          "name": "keyword.operator.declaration.functy",
          "match": ":="
        },
        {
          "name": "keyword.operator.namespace.functy",
          "match": "::"
        },
        {
          "name": "keyword.operator.splat.functy",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.functy",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.functy",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.functy",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.assignment.functy",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.functy",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.arithmetic.functy",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "expression": {
      "comment": "Shared HCL-style expression syntax used on statement RHSs and inside interpolations. Mirrors the top-level include list — a new call rule must be added in BOTH places, or it won't apply inside ${...}.",
      "patterns": [
        { "include": "#comment_block" },
        { "include": "#comment_line" },
        { "include": "#literal" },
        { "include": "#type_keyword" },
        { "include": "#string" },
        { "include": "#heredoc" },
        { "include": "#number" },
        { "include": "#qualified_call" },
        { "include": "#builtin_function" },
        { "include": "#function_call" },
        { "include": "#operator" }
      ]
    }
  }
}
