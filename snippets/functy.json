{
  "Namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:name}",
      "",
      "$0"
    ],
    "description": "Namespace declaration (must be the file's first declaration)"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}) {",
      "\t$0",
      "}"
    ],
    "description": "Function declaration"
  },
  "Private function": {
    "prefix": "_func",
    "body": [
      "func _${1:name}(${2:params}) {",
      "\t$0",
      "}"
    ],
    "description": "Namespace-local function: callable within its namespace, never registered with the host"
  },
  "Function with return type": {
    "prefix": "funcret",
    "body": [
      "func ${1:name}(${2:params}) -> ${3:type} {",
      "\treturn ${0:value}",
      "}"
    ],
    "description": "Function declaration with a return type"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "If statement"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If / else statement"
  },
  "For in": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "\t$0",
      "}"
    ],
    "description": "For-in loop over a collection"
  },
  "For (C-style)": {
    "prefix": "forc",
    "body": [
      "for ${1:i} := 0; ${1:i} < ${2:n}; ${1:i} = ${1:i} + 1 {",
      "\t$0",
      "}"
    ],
    "description": "C-style for loop"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:subject} {",
      "\tcase ${2:value}:",
      "\t\t$3",
      "\tdefault:",
      "\t\t$0",
      "}"
    ],
    "description": "Switch statement"
  },
  "Try / catch": {
    "prefix": "trycatch",
    "body": [
      "try {",
      "\t$1",
      "} catch ${2:e} {",
      "\t$0",
      "}"
    ],
    "description": "Try / catch block"
  },
  "Try / catch / finally": {
    "prefix": "tryfinally",
    "body": [
      "try {",
      "\t$1",
      "} catch ${2:e} {",
      "\t$3",
      "} finally {",
      "\t$0",
      "}"
    ],
    "description": "Try / catch / finally block"
  },
  "Defer": {
    "prefix": "defer",
    "body": [
      "defer {",
      "\t$0",
      "}"
    ],
    "description": "Defer a block until the enclosing function returns"
  },
  "Throw": {
    "prefix": "throw",
    "body": [
      "throw ${0:\"message\"}"
    ],
    "description": "Raise an error"
  },
  "Extern file": {
    "prefix": "extern",
    "body": [
      "//functy:extern",
      "",
      "// ${1:Describe what the host provides.}",
      "func ${2:name}(${3:x: string}) -> ${4:type}",
      "$0"
    ],
    "description": "An extern file: bodiless declarations describing the functions the HOST provides (never compiled, never callable)"
  },
  "Extern declaration": {
    "prefix": "externfunc",
    "body": [
      "func ${1:name}(${2:x: string}) -> ${3:type}"
    ],
    "description": "A bodiless extern declaration (only legal in a //functy:extern file)"
  },
  "Optional object attribute with a default": {
    "prefix": "optional",
    "body": [
      "optional(${1:number}, ${0:3})"
    ],
    "description": "An optional object attribute carrying a default value"
  },
  "Object type": {
    "prefix": "object",
    "body": [
      "object({",
      "\t${1:name} = ${2:string}",
      "\t${3:retries} = optional(${4:number}, ${0:3})",
      "})"
    ],
    "description": "An object type with a required and a defaulted-optional attribute"
  },
  "Test": {
    "prefix": "test",
    "body": [
      "test \"${1:description}\" {",
      "\tassert(${0:condition})",
      "}"
    ],
    "description": "Inline test block"
  },
  "Var": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${0:value}"
    ],
    "description": "Variable declaration"
  },
  "Const": {
    "prefix": "const",
    "body": [
      "const ${1:name} = ${0:value}"
    ],
    "description": "Top-level constant declaration"
  },
  "Type alias": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = ${0:type}"
    ],
    "description": "Type alias declaration"
  }
}
