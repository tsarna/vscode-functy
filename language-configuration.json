{
  // functy accepts both `//` and `#` line comments, but VS Code's toggle-comment
  // takes a single lineComment. `//` is the one to declare: it is what the
  // formatter emits, and it is the prefix of the `//functy:` file directives.
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  // VS Code's default word pattern, extended so a qualified name
  // (acme::math::double) counts as ONE word. Without this, a double-click or
  // ctrl+D on a namespaced call selects only a single segment, and word-based
  // suggestions offer the segments separately instead of the callable name.
  //
  // A single ':' stays a separator (it still ends a word in `x: number` and in
  // the ternary), and only the `::` pair joins segments. A leading '_' needs
  // nothing — it is already a word character, so `_helper` always selected whole.
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+(?:::[^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)*)",
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": "*/", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"']*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b",
      "end": "^\\s*//\\s*#?endregion\\b"
    }
  }
}
